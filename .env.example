NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://icare:icare@localhost:5432/icare?schema=public
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=replace-with-local-secret
JWT_REFRESH_SECRET=replace-with-local-refresh-secret
OTP_PROVIDER=development
SMS_PROVIDER_API_KEY=
SMS_PROVIDER_SENDER_ID=
LOCAL_STORAGE_ROOT=./storage
MATLAB_EXECUTABLE=matlab
MATLAB_DATA_ROOT=%USERPROFILE%/MATLAB Drive/SIH/data
MATLAB_MODEL_ROOT=%USERPROFILE%/MATLAB Drive/SIH/models
MATLAB_INFERENCE_MODE=batch

# Comma-separated list of allowed browser origins for the API.
# Leave empty to allow any localhost/127.0.0.1 dev origin.
CORS_ORIGINS=

# Local demo uses iamragav2k7@gmail.com / 123456 for all three staff roles
# when the corresponding variables below are empty. Patient OTP is 123456.
# Production requires unique accounts, bcrypt password hashes, and a strong JWT secret.
ICARE_WORKER_EMAIL=
ICARE_WORKER_PASSWORD_HASH=
ICARE_DOCTOR_EMAIL=
ICARE_DOCTOR_PASSWORD_HASH=
ICARE_ADMIN_EMAIL=
ICARE_ADMIN_PASSWORD_HASH=
ICARE_STAFF_JWT_SECRET=
